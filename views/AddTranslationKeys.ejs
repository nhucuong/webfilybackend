<%- include('includes/header',  {username: admin[0].name,email: admin[0].email } ) %>

<div class="body-wrapper">
    <div class="container-fluid">
        <!-- Header Card -->
        <div class="card bg-info-subtle shadow-none position-relative overflow-hidden mb-4">
            <div class="card-body px-4 py-3">
                <div class="row align-items-center">
                    <div class="col-md-6 col-sm-7">
                        <h4 class="fw-semibold mb-1">Manage Translation Keys (<%= translationManager.languageName %>)</h4>
                    </div>
                    <div class="col-md-6 col-sm-5 mt-3 mt-md-0">
  <div class="d-flex justify-content-md-end justify-content-start align-items-center gap-2">
    
    <a
     href="javascript:void(0)" onclick="goBack()"
      class="btn btn-outline-primary"
    >
      <i class="fas fa-arrow-left me-2"></i>
      Back To Translation
    </a>

    <button id="addkeyBtn" class="btn btn-primary">
      <i class="fa-solid fa-plus me-2"></i>
      Add Translation Keys
    </button>

  </div>
</div>
                </div>
            </div>
        </div>  

         <input
  type="hidden"
  id="translationManagerId"
  value="<%= translationManager._id %>"
>

        <!-- DataTable -->
        <div class="datatables">
            <div class="card">
                <div class="card-body">
                    <div class="table-responsive">
                        <table id="zero_config" class="table table-striped table-bordered text-nowrap align-middle">
                            <thead>
                                <tr>
                                    <th>Key</th>
                                    <th>Value</th>
                                </tr>
                            </thead>
                            <tbody>
                                <!-- Data will be loaded via AJAX -->
                            </tbody>
                        </table>
                        <button
  id="updateAllTranslations"
  class="btn btn-success mb-3"
>
  Update All
</button>
                    </div>
                </div>
            </div>

            <!-- Modal for Add/Edit Translation Key -->
            <div class="modal fade" id="translationkeyModal" tabindex="-1" aria-hidden="true">
                <div class="modal-dialog modal-md modal-dialog-centered">
                    <div class="modal-content border-0 shadow-lg rounded-3">
                       
                        <div class="modal-header bg-light-subtle">
                            <h5 class="modal-title fw-semibold" id="translationkeyModalLabel">Add Translation Key</h5>
                            <button type="button" class="btn-close btn-close-dark" data-bs-dismiss="modal"></button>
                        </div>

                        <div class="modal-body p-4">
                            <form id="translationkeysForm">
                                <input type="hidden" id="translationKeyId" name="id">

                                <div class="mb-3">
                                    <label class="form-label fw-medium">Key <span class="text-danger">*</span></label>
                                    <input type="text" id="translationKey" name="key" class="form-control" placeholder="Enter Key" required>
                                </div>
                                <div class="mb-3">
                                    <label class="form-label fw-medium">Value <span class="text-danger">*</span></label>
                                    <input type="text" id="translationvalue" name="value" class="form-control" placeholder="Enter Key Translation Valur" required>
                                </div>
                            </form>
                        </div>

                        <div class="modal-footer border-0 pt-0">
                            <button class="btn btn-light" data-bs-dismiss="modal">Cancel</button>
                            <button type="submit" form="translationkeysForm" class="btn btn-primary px-4">Save</button>
                        </div>

                    </div>
                </div>
            </div>
        </div>

    </div>
</div>

    </div>

    <%- include('includes/allscripts') %>
        <script src="/js/view/addtranslationkeys.js"></script>
        <script src="/js/view/pageback.js"></script>