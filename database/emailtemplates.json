  {
    "_id": "6979da91529ef23ef8be3361",
    "type": "website_publish",
    "subject": "Website Exported",
    "htmlContent": "<div style=\"margin:0;padding:0;background:#f4f6f8;font-family:Arial,Helvetica,sans-serif;\">\n\n\n\n <table width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" style=\"background:#f4f6f8;padding:30px 0;\">\n\n <tbody><tr>\n\n  <td align=\"center\">\n\n  <table width=\"600\" cellpadding=\"0\" cellspacing=\"0\" style=\"background:#ffffff;border-radius:8px;overflow:hidden;\n\n   box-shadow:0 5px 15px rgba(0,0,0,0.08);\">\n\n\n\n   <!-- Header -->\n\n   <tbody><tr>\n\n   <td style=\"background:#0d6efd;padding:24px;text-align:center;\">\n\n    {{site_logo}}\n\n    <p style=\"margin:6px 0 0;color:#e9f1ff;font-size:14px;\">\n\n      Website Exported Successful</p>\n\n   </td>\n\n   </tr>\n\n\n\n   <!-- Body -->\n\n   <tr>\n\n   <td style=\"padding:30px;color:#333333;\">\n\n    <h2 style=\"margin-top:0;font-size:20px;\">\n\n    Hello {{firstName}},\n\n    </h2>\n\n\n\n    <p style=\"font-size:14px;line-height:1.6;\">\n\n    Great news! Your website Exported request has been processed successfully on <strong>{{site_name}}</strong>.\n\n    </p>\n\n\n\n    <!-- Leads Info Box -->\n\n    <div style=\"text-align:center;margin:30px 0;\">\n\n    <div style=\"\n\n     display:inline-block;\n\n     padding:20px 30px;\n\n     font-size:16px;\n\n     font-weight:bold;\n\n     color:#0d6efd;\n\n     border:2px dashed #0d6efd;\n\n     border-radius:8px;\n\n     background:#f8faff;\">\n\n  Website Name - {{web_name}}</div></div>\n\n\n\n    <p style=\"font-size:14px;line-height:1.6;\">\n\n    You can now access these Website from your dashboard. Make sure to follow up promptly to get the best results.\n\n    </p>\n\n\n\n    <p style=\"margin-top:24px;font-size:13px;color:#777;\">\n\n    If you did not request this, please contact our support team immediately.\n\n    </p>\n\n\n\n    <p style=\"margin-top:30px;font-size:14px;\">\n\n    Best Regards,<br>\n\n    <strong>{{site_name}} Support Team</strong>\n\n    </p>\n\n   </td>\n\n   </tr>\n\n\n\n   <!-- Footer -->\n\n   <tr>\n\n   <td style=\"background:#f1f3f5;padding:15px;text-align:center;\n\n    font-size:12px;color:#888;\">\n\n    © {{site_name}} — All rights reserved\n\n   </td>\n\n   </tr>\n\n\n\n  </tbody></table>\n\n  </td>\n\n </tr>\n\n </tbody></table>\n\n</div>\n\n",
    "variables": [
      "firstName",
      "site_name",
      "web_name",
      "site_logo"
    ],
