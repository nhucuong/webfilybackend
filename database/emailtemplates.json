  {
    "_id": "6979db0d529ef23ef8be3362",
    "type": "subscription_success",
    "subject": "Your Subscription is Active",
    "htmlContent": "<div style=\"margin:0;padding:0;background:#f4f6f8;font-family:Arial,Helvetica,sans-serif;\">\n\n <table width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" style=\"background:#f4f6f8;padding:30px 0;\">\n\n  <tbody><tr>\n\n   <td align=\"center\">\n\n    <table width=\"600\" cellpadding=\"0\" cellspacing=\"0\" style=\"background:#ffffff;border-radius:8px;overflow:hidden;box-shadow:0 5px 15px rgba(0,0,0,0.08);\">\n\n\n\n     <!-- Header -->\n\n     <tbody><tr>\n\n      <td style=\"background:#0d6efd;padding:20px;text-align:center;\">\n{{site_logo}}\n\n       <p style=\"margin:5px 0 0;color:#e9f1ff;font-size:14px;\">Subscription Activated</p>\n\n      </td>\n\n     </tr>\n\n\n\n     <!-- Body -->\n\n     <tr>\n\n      <td style=\"padding:30px;color:#333333;\">\n\n       <h2 style=\"margin-top:0;font-size:20px;\">Hello {{firstName}},</h2>\n\n\n\n       <p style=\"font-size:14px;line-height:1.6;\">\n\n        Thank you for subscribing to <strong>{{site_name}}</strong>.\n\n        Your subscription has been successfully activated.\n\n       </p>\n\n\n\n       <p style=\"font-size:14px;line-height:1.6;\">\n\n        <strong>Plan:</strong> {{plan_name}}<br>\n\n       </p>\n\n\n\n\n\n\n\n       <p style=\"font-size:13px;color:#666;\">\n\n        If you have any questions or need help, feel free to contact our support team.\n\n       </p>\n\n\n\n       <p style=\"margin-top:30px;font-size:14px;\">\n\n        Best Regards,<br>\n\n        <strong>{{site_name}} Support Team</strong>\n\n       </p>\n\n      </td>\n\n     </tr>\n\n\n\n     <!-- Footer -->\n\n     <tr>\n\n      <td style=\"background:#f1f3f5;padding:15px;text-align:center;font-size:12px;color:#888;\">\n\n       © {{site_name}} — All rights reserved\n\n      </td>\n\n     </tr>\n\n\n\n    </tbody></table>\n\n   </td>\n\n  </tr>\n\n </tbody></table>\n\n</div>",
    "variables": [
      "firstName",
      "site_name",
      "plan_name",
      "billingType",
