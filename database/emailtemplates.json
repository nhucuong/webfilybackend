  {
    "_id": "6979db1a529ef23ef8be3363",
    "type": "reset_password",
    "subject": "Reset Your Password",
    "htmlContent": "<div style=\"margin:0;padding:0;background:#f4f6f8;font-family:Arial,Helvetica,sans-serif;\">\n\n <table width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" style=\"background:#f4f6f8;padding:30px 0;\">\n\n  <tbody><tr>\n\n   <td align=\"center\">\n\n    <table width=\"600\" cellpadding=\"0\" cellspacing=\"0\" style=\"background:#ffffff;border-radius:8px;overflow:hidden;\n\n     box-shadow:0 5px 15px rgba(0,0,0,0.08);\">\n\n\n\n     <!-- Header -->\n\n     <tbody><tr>\n\n      <td style=\"background:#0d6efd;padding:24px;text-align:center;\">\n\n      {{site_logo}}\n\n       <p style=\"margin:6px 0 0;color:#e9f1ff;font-size:14px;\">\n\n        Password Reset\n\n       </p>\n\n      </td>\n\n     </tr>\n\n\n\n     <!-- Body -->\n\n     <tr>\n\n      <td style=\"padding:30px;color:#333333;\">\n\n       <h2 style=\"margin-top:0;font-size:20px;\">\n\n        Hello {{firstName}},\n\n       </h2>\n\n\n\n       <p style=\"font-size:14px;line-height:1.6;\">\n\n        We received a request to reset your password for your\n\n        <strong>{{site_name}}</strong> account.\n\n       </p>\n\n\n\n       <p style=\"font-size:14px;line-height:1.6;\">\n\n        Click the button below to create a new password.\n\n        This link is valid for <strong>30 minutes</strong>.\n\n       </p>\n\n\n\n       <!-- Button -->\n\n       <div style=\"text-align:center;margin:32px 0;\">\n\n        <a href=\"{{reset_link}}\" style=\"background:#0d6efd;color:#ffffff;text-decoration:none;\n\n         padding:14px 30px;border-radius:6px;\n\n         display:inline-block;font-size:15px;font-weight:bold;\">\n\n         Reset Password\n\n        </a>\n\n       </div>\n\n\n\n       <p style=\"font-size:13px;color:#666;\">\n\n        If the button doesn’t work, copy and paste this link into your browser:\n\n       </p>\n\n\n\n     \n\n       <p style=\"margin-top:24px;font-size:13px;color:#777;\">\n\n        If you didn’t request a password reset, you can safely ignore this email.\n\n       </p>\n\n\n\n       <p style=\"margin-top:30px;font-size:14px;\">\n\n        Best Regards,<br>\n\n        <strong>{{site_name}} Support Team</strong>\n\n       </p>\n\n      </td>\n\n     </tr>\n\n\n\n     <!-- Footer -->\n\n     <tr>\n\n      <td style=\"background:#f1f3f5;padding:15px;text-align:center;\n\n       font-size:12px;color:#888;\">\n\n       © {{site_name}} — All rights reserved\n\n      </td>\n\n     </tr>\n\n\n\n    </tbody></table>\n\n   </td>\n\n  </tr>\n\n </tbody></table>\n\n</div>\n\n",
    "variables": [
      "reset_link",
      "site_name",
      "firstName",
      "site_logo"
    ],
    "from_name": "Support Team",
    "from_email": "example@gmail.com",
    "createdAt": "2026-02-02T06:40:23.588Z",
    "updatedAt": "2026-04-08T10:30:29.373Z",
    "__v": 0
  },
